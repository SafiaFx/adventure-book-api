{
    "name": "safiafx/adventure-book-api",
    "description": "A read-only books and authors API built with PHP, Slim 4 and PDO.",
    "keywords": [
        "books",
        "api",
        "slim",
        "php"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "@php -S 127.0.0.1:8080 -t public public/router.php",
        "test": "@php vendor/bin/phpunit",
        "db:setup": "@php bin/setup-database.php"
    }
}
